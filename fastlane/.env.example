# Copy to fastlane/.env (git-ignored) and fill in from 1Password:
# "Fastlane App Store distribution" in the Private vault.

# The `password` field. Decrypts everything in RISCfuture/certificates.
MATCH_PASSWORD=

# base64 of "<user>:<GitHub PAT>", from the same item's `GitHub PAT` field.
# Only needed where git cannot authenticate to the certificates repo on its
# own; a laptop with SSH or a credential helper can leave this unset.
MATCH_GIT_BASIC_AUTHORIZATION=
