# Build products
build/
dist/
cmake-build-*/
docs/manual/*.pdf

# Source material that is not ours to redistribute
reference/

# Editor and OS clutter
.idea/
.DS_Store
.art-preview/

# Python
__pycache__/
*.py[cod]

# Ruby (fastlane only). The lockfile is not committed: fastlane is a signing
# helper, not a dependency of the plugin, and pinning it would tie CI to a
# specific Ruby and Bundler.
.bundle/
vendor/bundle/
Gemfile.lock
fastlane/report.xml
# Regenerated by fastlane on every run; the Fastfile documents its own lanes.
fastlane/README.md

# Local secrets (fastlane loads this on startup)
fastlane/.env
